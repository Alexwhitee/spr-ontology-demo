    <rdfs:label>SPRInspectionResult</rdfs:label>
    <rdfs:comment>SPR inspection result.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#SPRDefectPattern">
    <rdfs:subClassOf rdf:resource="#DefectPattern"/>
    <rdfs:label>SPRDefectPattern</rdfs:label>
    <rdfs:comment>SPR defect pattern.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#SPRRootCause">
    <rdfs:subClassOf rdf:resource="#RootCause"/>
    <rdfs:label>SPRRootCause</rdfs:label>
    <rdfs:comment>SPR root cause.</rdfs:comment>
