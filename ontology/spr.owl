<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <owl:Ontology rdf:about="https://example.com/ontology/spr">
    <rdfs:comment>Generated OWL2 module for spr.owl.</rdfs:comment>
  </owl:Ontology>
  <owl:Class rdf:about="#SPRProcess">
    <rdfs:subClassOf rdf:resource="#ManufacturingProcess"/>
    <rdfs:label>SPR工艺</rdfs:label>
    <rdfs:comment>SPR 自冲铆工艺扩展。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#SPRProcessRecord">
    <rdfs:subClassOf rdf:resource="#OnlineProcessRecord"/>
    <rdfs:label>SPR过程记录</rdfs:label>
    <rdfs:comment>每一条 SPR 数据库记录的统一承载入口。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#SPRConnectionPoint">
    <rdfs:subClassOf rdf:resource="#Entity"/>
    <rdfs:label>SPR连接点</rdfs:label>
    <rdfs:comment>SPR 铆点或连接特征。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#SPRRivet">
    <rdfs:subClassOf rdf:resource="#Entity"/>
    <rdfs:label>SPR铆钉</rdfs:label>
    <rdfs:comment>SPR 工艺使用的铆钉对象。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#SPRDie">
    <rdfs:subClassOf rdf:resource="#Tooling"/>
    <rdfs:label>SPR铆模</rdfs:label>
    <rdfs:comment>SPR 工艺中的铆模或模具。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#SPRProgram">
    <rdfs:subClassOf rdf:resource="#Program"/>
    <rdfs:label>SPR程序</rdfs:label>
    <rdfs:comment>SPR 设备执行的工艺程序。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#SPRParameterSet">
    <rdfs:subClassOf rdf:resource="#ParameterSet"/>
    <rdfs:label>SPR参数集</rdfs:label>
    <rdfs:comment>SPR 工艺参数集合。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#SPRCurveData">
    <rdfs:subClassOf rdf:resource="#CurveData"/>
    <rdfs:label>SPR曲线数据</rdfs:label>
    <rdfs:comment>SPR 过程中的实际曲线和派生曲线。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#SPREnvelopeCurve">
    <rdfs:subClassOf rdf:resource="#EnvelopeCurve"/>
    <rdfs:label>SPR包络线</rdfs:label>
    <rdfs:comment>SPR 曲线判断使用的包络线。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#SPRInspectionProcess">
    <rdfs:subClassOf rdf:resource="#InspectionProcess"/>
    <rdfs:label>SPR检测流程</rdfs:label>
    <rdfs:comment>读取 SPR 过程记录、调用模型或规则并生成检测结果的流程。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#SPRInspectionResult">
    <rdfs:subClassOf rdf:resource="#InspectionResult"/>
    <rdfs:label>SPR检测结果</rdfs:label>
    <rdfs:comment>SPR 检测流程输出的质量结果。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#SPRDefectPattern">
    <rdfs:subClassOf rdf:resource="#DefectPattern"/>
    <rdfs:label>SPR缺陷模式</rdfs:label>
    <rdfs:comment>SPR 场景中的缺陷或异常类型。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#SPRRootCause">
    <rdfs:subClassOf rdf:resource="#RootCause"/>
    <rdfs:label>SPR根因</rdfs:label>
    <rdfs:comment>SPR 缺陷对应的候选根因。</rdfs:comment>
  </owl:Class>
</rdf:RDF>
