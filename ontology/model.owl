<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <owl:Ontology rdf:about="https://example.com/ontology/model">
    <rdfs:comment>Generated OWL2 module for model.owl.</rdfs:comment>
  </owl:Ontology>
  <owl:Class rdf:about="#DetectionModel">
    <rdfs:subClassOf rdf:resource="#Service"/>
    <rdfs:label>检测模型</rdfs:label>
    <rdfs:comment>用于检测过程记录的 AI 模型或本体规则模型。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#TimeSeriesForecastModel">
    <rdfs:subClassOf rdf:resource="#DetectionModel"/>
    <rdfs:label>异常检测模型</rdfs:label>
    <rdfs:comment>用于对过程曲线做重构式异常检测的模型，例如本地 MARPP 重构服务。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#ModelService">
    <rdfs:subClassOf rdf:resource="#Service"/>
    <rdfs:label>模型服务</rdfs:label>
    <rdfs:comment>可被调用的模型服务接口。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#ModelInvocation">
    <rdfs:subClassOf rdf:resource="#TraceableEntity"/>
    <rdfs:label>模型调用记录</rdfs:label>
    <rdfs:comment>一次具体模型调用的请求、响应和状态记录。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#ModelInputTemplate">
    <rdfs:subClassOf rdf:resource="#Entity"/>
    <rdfs:label>模型输入模板</rdfs:label>
    <rdfs:comment>模型需要接收的字段结构。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#ModelOutputTemplate">
    <rdfs:subClassOf rdf:resource="#Entity"/>
    <rdfs:label>模型输出模板</rdfs:label>
    <rdfs:comment>模型需要返回的结构化结果。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#ModelPredictionResult">
    <rdfs:subClassOf rdf:resource="#InspectionResult"/>
    <rdfs:label>模型预测结果</rdfs:label>
    <rdfs:comment>模型或规则服务输出的预测类别、置信度和证据。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#ForecastHorizon">
    <rdfs:subClassOf rdf:resource="#Entity"/>
    <rdfs:label>序列长度</rdfs:label>
    <rdfs:comment>重构式异常检测模型输入曲线的点数或时间跨度的语义描述。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#PredictedCurve">
    <rdfs:subClassOf rdf:resource="#CurveData"/>
    <rdfs:label>重构曲线</rdfs:label>
    <rdfs:comment>模型对输入过程曲线进行重构得到的派生曲线。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#ForecastAnomalyEvent">
    <rdfs:subClassOf rdf:resource="#AnomalyEvent"/>
    <rdfs:label>重构异常事件</rdfs:label>
    <rdfs:comment>由重构误差触发的异常事件。</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#ModelCallLog">
    <rdfs:subClassOf rdf:resource="#TraceableEntity"/>
    <rdfs:label>模型调用日志</rdfs:label>
    <rdfs:comment>模型调用过程中的日志和降级状态。</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="#invokesModel">
    <rdfs:label>调用检测模型</rdfs:label>
    <rdfs:domain rdf:resource="#InspectionProcess"/>
    <rdfs:range rdf:resource="#DetectionModel"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#usesInputTemplate">
    <rdfs:label>使用输入模板</rdfs:label>
    <rdfs:domain rdf:resource="#ModelInvocation"/>
    <rdfs:range rdf:resource="#ModelInputTemplate"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#usesOutputTemplate">
    <rdfs:label>使用输出模板</rdfs:label>
    <rdfs:domain rdf:resource="#ModelInvocation"/>
    <rdfs:range rdf:resource="#ModelOutputTemplate"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#producedByModel">
    <rdfs:label>由模型产生</rdfs:label>
    <rdfs:domain rdf:resource="#ModelPredictionResult"/>
    <rdfs:range rdf:resource="#DetectionModel"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasPredictionResult">
    <rdfs:label>包含预测结果</rdfs:label>
    <rdfs:domain rdf:resource="#InspectionProcess"/>
    <rdfs:range rdf:resource="#ModelPredictionResult"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#supportsInspectionResult">
    <rdfs:label>支持检测结果</rdfs:label>
    <rdfs:domain rdf:resource="#ModelPredictionResult"/>
    <rdfs:range rdf:resource="#InspectionResult"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasModelCallLog">
    <rdfs:label>模型调用日志</rdfs:label>
    <rdfs:domain rdf:resource="#ModelInvocation"/>
    <rdfs:range rdf:resource="#ModelCallLog"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasForecastHorizon">
    <rdfs:label>序列长度</rdfs:label>
    <rdfs:domain rdf:resource="#ModelInvocation"/>
    <rdfs:range rdf:resource="#ForecastHorizon"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#predictsCurve">
    <rdfs:label>重构曲线</rdfs:label>
    <rdfs:domain rdf:resource="#ModelPredictionResult"/>
    <rdfs:range rdf:resource="#PredictedCurve"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="#predictionCategory">
    <rdfs:label>预测类别</rdfs:label>
    <rdfs:domain rdf:resource="#ModelPredictionResult"/>
    <rdfs:range rdf:resource="xsd:string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#confidence">
    <rdfs:label>置信度</rdfs:label>
    <rdfs:domain rdf:resource="#ModelPredictionResult"/>
    <rdfs:range rdf:resource="xsd:decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#modelName">
    <rdfs:label>模型名称</rdfs:label>
    <rdfs:domain rdf:resource="#DetectionModel"/>
    <rdfs:range rdf:resource="xsd:string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#modelVersion">
    <rdfs:label>模型版本</rdfs:label>
    <rdfs:domain rdf:resource="#DetectionModel"/>
    <rdfs:range rdf:resource="xsd:string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#apiEndpoint">
    <rdfs:label>API地址</rdfs:label>
    <rdfs:domain rdf:resource="#ModelService"/>
    <rdfs:range rdf:resource="xsd:anyURI"/>
  </owl:DatatypeProperty>
</rdf:RDF>
