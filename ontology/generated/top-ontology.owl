<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <owl:Ontology rdf:about="https://example.com/ontology/top-ontology">
    <rdfs:comment>Aggregate top-level process ontology generated from core process modules.</rdfs:comment>
    <owl:imports rdf:resource="../core.owl"/>
    <owl:imports rdf:resource="../process.owl"/>
    <owl:imports rdf:resource="../resource.owl"/>
    <owl:imports rdf:resource="../quality.owl"/>
    <owl:imports rdf:resource="../model.owl"/>
  </owl:Ontology>
</rdf:RDF>
