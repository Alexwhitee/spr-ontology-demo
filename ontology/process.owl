<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <owl:Ontology rdf:about="https://example.com/ontology/process">
    <rdfs:comment>Generated OWL2 module for process.owl.</rdfs:comment>
  </owl:Ontology>
  <owl:Class rdf:about="#ManufacturingProcess">
    <rdfs:subClassOf rdf:resource="#Entity"/>
    <rdfs:label>ManufacturingProcess</rdfs:label>
    <rdfs:comment>Top-level process abstraction.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#ProcessRoute">
    <rdfs:subClassOf rdf:resource="#VersionedEntity"/>
    <rdfs:label>ProcessRoute</rdfs:label>
    <rdfs:comment>A route containing operations and steps.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#ProcessOperation">
    <rdfs:subClassOf rdf:resource="#Entity"/>
    <rdfs:label>ProcessOperation</rdfs:label>
    <rdfs:comment>Operation phase within a process route.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#ProcessStep">
    <rdfs:subClassOf rdf:resource="#Entity"/>
    <rdfs:label>ProcessStep</rdfs:label>
    <rdfs:comment>Executable process step.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#ParameterSet">
    <rdfs:subClassOf rdf:resource="#VersionedEntity"/>
    <rdfs:label>ParameterSet</rdfs:label>
    <rdfs:comment>Parameter collection used by a step.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#ProcessWindow">
    <rdfs:subClassOf rdf:resource="#VersionedEntity"/>
    <rdfs:label>ProcessWindow</rdfs:label>
    <rdfs:comment>Allowed process boundary.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#OnlineProcessRecord">
    <rdfs:subClassOf rdf:resource="#TraceableEntity"/>
    <rdfs:label>OnlineProcessRecord</rdfs:label>
    <rdfs:comment>Online record collected from equipment or data platform.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#ProcessData">
    <rdfs:subClassOf rdf:resource="#TraceableEntity"/>
    <rdfs:label>ProcessData</rdfs:label>
    <rdfs:comment>Data produced during process execution.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#CurveData">
    <rdfs:subClassOf rdf:resource="#ProcessData"/>
    <rdfs:label>CurveData</rdfs:label>
    <rdfs:comment>Sampled curve data.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#ReferenceCurve">
    <rdfs:subClassOf rdf:resource="#CurveData"/>
    <rdfs:label>ReferenceCurve</rdfs:label>
    <rdfs:comment>Reference curve used for evaluation.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#EnvelopeCurve">
    <rdfs:subClassOf rdf:resource="#ReferenceCurve"/>
    <rdfs:label>EnvelopeCurve</rdfs:label>
    <rdfs:comment>Envelope boundary for curve-based process judgment.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#DataProcessingProcess">
    <rdfs:subClassOf rdf:resource="#TraceableEntity"/>
    <rdfs:label>DataProcessingProcess</rdfs:label>
    <rdfs:comment>Processing pipeline from raw data to derived data.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="#hasOperation">
    <rdfs:label>hasOperation</rdfs:label>
    <rdfs:domain rdf:resource="#ProcessRoute"/>
    <rdfs:range rdf:resource="#ProcessOperation"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasStep">
    <rdfs:label>hasStep</rdfs:label>
    <rdfs:domain rdf:resource="#ProcessOperation"/>
    <rdfs:range rdf:resource="#ProcessStep"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#usesParameterSet">
    <rdfs:label>usesParameterSet</rdfs:label>
    <rdfs:domain rdf:resource="#ProcessStep"/>
    <rdfs:range rdf:resource="#ParameterSet"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasProcessWindow">
    <rdfs:label>hasProcessWindow</rdfs:label>
    <rdfs:domain rdf:resource="#ProcessStep"/>
    <rdfs:range rdf:resource="#ProcessWindow"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasProcessData">
    <rdfs:label>hasProcessData</rdfs:label>
    <rdfs:domain rdf:resource="#OnlineProcessRecord"/>
    <rdfs:range rdf:resource="#ProcessData"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasCurveData">
    <rdfs:label>hasCurveData</rdfs:label>
    <rdfs:domain rdf:resource="#OnlineProcessRecord"/>
    <rdfs:range rdf:resource="#CurveData"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasReferenceCurve">
    <rdfs:label>hasReferenceCurve</rdfs:label>
    <rdfs:domain rdf:resource="#InspectionProcess"/>
    <rdfs:range rdf:resource="#ReferenceCurve"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasEnvelopeCurve">
    <rdfs:label>hasEnvelopeCurve</rdfs:label>
    <rdfs:domain rdf:resource="#InspectionProcess"/>
    <rdfs:range rdf:resource="#EnvelopeCurve"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#derivedFrom">
    <rdfs:label>derivedFrom</rdfs:label>
    <rdfs:domain rdf:resource="#ProcessData"/>
    <rdfs:range rdf:resource="#ProcessData"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="#recordId">
    <rdfs:label>recordId</rdfs:label>
    <rdfs:domain rdf:resource="#OnlineProcessRecord"/>
    <rdfs:range rdf:resource="xsd:string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#sourceTable">
    <rdfs:label>sourceTable</rdfs:label>
    <rdfs:domain rdf:resource="#OnlineProcessRecord"/>
    <rdfs:range rdf:resource="xsd:string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#timestamp">
    <rdfs:label>timestamp</rdfs:label>
    <rdfs:domain rdf:resource="#OnlineProcessRecord"/>
    <rdfs:range rdf:resource="xsd:dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#parameterValue">
    <rdfs:label>parameterValue</rdfs:label>
    <rdfs:domain rdf:resource="#ProcessData"/>
    <rdfs:range rdf:resource="xsd:decimal"/>
  </owl:DatatypeProperty>
</rdf:RDF>
